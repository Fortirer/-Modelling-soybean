# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/

# Trained model binaries: large and fully regenerable by running the scripts
# (models/**/*.pkl covers the per-state subfolders, e.g. models/IA/)
models/*.pkl
models/**/*.pkl

# S3 path lookup cache for script 12: a local speed-up, rebuilt on demand
# (data/processed/**/ covers the per-state subfolders, e.g. data/processed/IA/)
data/processed/cmip6_path_index.json
data/processed/**/cmip6_path_index.json

# OS
.DS_Store
Thumbs.db

# Daily weather pull for script 17: 30 MB, regenerated in ~3.5 min by
# `python scripts/17_download_daily_weather.py` from a documented public API
# (data/raw/**/ covers the per-state subfolders, e.g. data/raw/IA/)
data/raw/power_daily.csv.gz
data/raw/**/power_daily.csv.gz

# Per-year EPA download cache for script 22; the assembled annual series is kept
data/raw/epa_ozone_cache/
data/raw/**/epa_ozone_cache/

# Per-municipality SoilGrids download cache for Brazil script br_08 (one
# small JSON per municipality, makes a restart resumable); the assembled
# soilgrids_horizons.csv is kept
data/raw/**/soilgrids_cache/

# Gap-filling downloads (scripts 39, 40, 44-46): large and regenerable from
# public sources; see docs/DADOS_FALTANTES.md
data/raw/daymet_daily.csv.gz
data/raw/**/daymet_daily.csv.gz
data/raw/**/nex_gddp/
data/raw/global/nldas_cache/
data/raw/global/era5land_cache/
data/raw/**/*.tmp.gz
.pytest_cache/

# MODIS per-municipality download cache for script 53 (resumable)
data/raw/**/modis_cache/

# Weekly in-season weather for script 51 (26 weeks x 4 variables, ~150 MB in
# total): rebuilt in a few minutes by script 50 from the daily files
data/processed/**/weekly_weather_features.csv
